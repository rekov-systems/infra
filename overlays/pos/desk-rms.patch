+      const form = new URLSearchParams({ client_id: appId, client_secret: appSecret, code });
+      const exchange = await fetch(`https://graph.facebook.com/${graphVersion}/oauth/access_token`, { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: form });
+      const exchanged = await exchange.json().catch(() => ({}));
+      if (!exchange.ok || !exchanged?.access_token) return json({ error: exchanged?.error?.message ?? "Meta no pudo completar la autorización" }, 422);
+      token = String(exchanged.access_token);
+    }
+    const check = await fetch(`https://graph.facebook.com/${normalizeGraphVersion(Deno.env.get("META_GRAPH_VERSION") ?? "v26.0")}/${phoneNumberId}?fields=display_phone_number,verified_name`, { headers: { Authorization: `Bearer ${token}` } });
+    const account = await check.json().catch(() => ({}));
+    if (!check.ok) return json({ error: account?.error?.message ?? `Meta Graph respondió HTTP ${check.status}` }, 422);
