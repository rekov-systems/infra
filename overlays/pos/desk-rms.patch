+export async function decryptToken(value: string) {
+  const packed = Uint8Array.from(atob(value), (c) => c.charCodeAt(0));
+  const raw = Deno.env.get("TENANT_SECRETS_ENCRYPTION_KEY");
+  if (!raw) throw new Error("Falta TENANT_SECRETS_ENCRYPTION_KEY en los secrets de Edge Functions");
+  const keyBytes = Uint8Array.from(atob(raw), (c) => c.charCodeAt(0));
+  const key = await crypto.subtle.importKey("raw", keyBytes, "AES-GCM", false, ["decrypt"]);
+  const decrypted = await crypto.subtle.decrypt({ name: "AES-GCM", iv: packed.slice(0, 12) }, key, packed.slice(12));
+  return new TextDecoder().decode(decrypted);
+}
+async function encrypt(value: string) {
+  const raw = Deno.env.get("TENANT_SECRETS_ENCRYPTION_KEY");
+  if (!raw) throw new Error("Falta TENANT_SECRETS_ENCRYPTION_KEY en los secrets de Edge Functions");
+  const bytes = Uint8Array.from(atob(raw), (c) => c.charCodeAt(0));
+  if (bytes.length !== 32) throw new Error("TENANT_SECRETS_ENCRYPTION_KEY debe contener 32 bytes en base64");
+  const key = await crypto.subtle.importKey("raw", bytes, "AES-GCM", false, ["encrypt"]);
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const ciphertext = new Uint8Array(await crypto.subtle.encrypt({ name: "AES-GCM", iv }, key, new TextEncoder().encode(value)));
+  const packed = new Uint8Array(12 + ciphertext.length); packed.set(iv); packed.set(ciphertext, 12);
+  return btoa(String.fromCharCode(...packed));
+}
+function json(body: unknown, status = 200) { return new Response(JSON.stringify(body), { status, headers: { ...corsHeaders, "Content-Type": "application/json" } }); }
+function normalizeGraphVersion(value: string) { const version = value.trim().replace(/^v/i, ""); if (!/^\d+\.\d+$/.test(version)) throw new Error("META_GRAPH_VERSION inválida"); return `v${version}`; }
