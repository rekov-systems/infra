diff --git a/apps/pos/supabase/functions/jcflow/index.ts b/apps/pos/supabase/functions/jcflow/index.ts
new file mode 100644
index 0000000..c4ec0de
--- /dev/null
+++ b/apps/pos/supabase/functions/jcflow/index.ts
@@ -0,0 +1,127 @@
+import { createClient } from "npm:@supabase/supabase-js@2";
+
+const corsHeaders = {
+  "Access-Control-Allow-Origin": "*",
+  "Access-Control-Allow-Headers": "authorization, x-client-info, apikey, content-type",
+  "Access-Control-Allow-Methods": "POST, OPTIONS",
+};
+const supabaseUrl = Deno.env.get("SUPABASE_URL")!;
+const anonKey = Deno.env.get("SUPABASE_ANON_KEY")!;
+const serviceKey = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!;
+const admin = createClient(supabaseUrl, serviceKey);
+
+Deno.serve(async (req) => {
+  if (req.method === "OPTIONS") return new Response("ok", { headers: corsHeaders });
+  if (req.method !== "POST") return json({ error: "Method not allowed" }, 405);
+
+  try {
+    const authorization = req.headers.get("Authorization") ?? "";
+    if (!authorization) return json({ error: "No autenticado" }, 401);
+    const userClient = createClient(supabaseUrl, anonKey, {
+      global: { headers: { Authorization: authorization } },
+      auth: { persistSession: false },
+    });
+    const { data: { user } } = await userClient.auth.getUser();
+    if (!user) return json({ error: "No autenticado" }, 401);
+
+    const body = await req.json();
+    const { action, tenant_id: tenantId } = body ?? {};
+    if (!tenantId) return json({ error: "tenant_id requerido" }, 400);
+    const { data: membership } = await admin.from("user_roles")
+      .select("role").eq("user_id", user.id).eq("tenant_id", tenantId);
+    if (!membership?.length) return json({ error: "Sin acceso a este negocio" }, 403);
+
+    if (action === "get_status") {
+      const { data } = await admin.from("tenant_jcflow_credentials").select("updated_at").eq("tenant_id", tenantId).maybeSingle();
+      return json({ configured: !!data, updated_at: data?.updated_at ?? null });
+    }
+
+    if (action === "save_credentials") {
+      if (!membership.some((m) => ["owner", "admin"].includes(m.role))) return json({ error: "Solo owner/admin puede configurar facturación" }, 403);
+      const apiKey = String(body.api_key ?? "").trim();
+      if (!/^jcf_(test|live)_[A-Za-z0-9_-]{8,}$/.test(apiKey)) return json({ error: "La clave no tiene el formato esperado de JCFlow" }, 400);
+      const encrypted = await encrypt(apiKey);
+      const { error } = await admin.from("tenant_jcflow_credentials").upsert({ tenant_id: tenantId, encrypted_api_key: encrypted, updated_at: new Date().toISOString() });
+      if (error) throw error;
+      return json({ ok: true, mode: apiKey.startsWith("jcf_test_") ? "sandbox" : "produccion" });
+    }
+
+    if (action === "issue_invoice") {
+      const saleId = String(body.sale_id ?? "");
+      if (!saleId) return json({ error: "sale_id requerido" }, 400);
+      const { data: existing } = await admin.from("jcflow_invoices").select("id, cufe, status, response").eq("tenant_id", tenantId).eq("sale_id", saleId).maybeSingle();
+      if (existing) return json({ error: "Esta venta ya tiene una factura registrada", invoice: existing }, 409);
+
+      const { data: sale, error: saleError } = await admin.from("sales")
+        .select("id, tenant_id, branch_id, status, subtotal, tax_total, total, customer_id, customers(name, email, document_number), sale_items(product_name, quantity, unit_price, tax_rate, discount)")
+        .eq("id", saleId).eq("tenant_id", tenantId).single();
+      if (saleError || !sale) return json({ error: "Venta no encontrada" }, 404);
+      const branchRoles = await admin.from("user_roles").select("role").eq("user_id", user.id).eq("tenant_id", tenantId).or(`branch_id.is.null,branch_id.eq.${sale.branch_id}`);
+      if (!branchRoles.data?.length) return json({ error: "No tienes acceso a la sucursal de esta venta" }, 403);
+      if (sale.status !== "completed") return json({ error: "Solo se pueden facturar ventas completadas" }, 409);
+
+      const { data: credentials } = await admin.from("tenant_jcflow_credentials").select("encrypted_api_key").eq("tenant_id", tenantId).single();
+      if (!credentials) return json({ error: "Rekov aún no configuró las credenciales de facturación para este negocio" }, 409);
+      const apiKey = await decrypt(credentials.encrypted_api_key);
+      const customer = Array.isArray(sale.customers) ? sale.customers[0] : sale.customers;
+      if (!customer?.document_number) return json({ error: "Selecciona un cliente con documento registrado antes de facturar" }, 422);
+
+      const payload = {
+        cliente: {
+          numero_documento: customer.document_number,
+          tipo_documento: customer.document_number.replace(/\D/g, "").length === 9 ? "NIT" : "CC",
+          razon_social: customer.name,
+          ...(customer.email ? { email: customer.email } : {}),
+        },
+        lineas: (sale.sale_items ?? []).map((item: any) => ({
+          descripcion: item.product_name,
+          cantidad: Number(item.quantity),
+          precio_unitario: Math.max(0, Number(item.unit_price) - Number(item.discount ?? 0) / Math.max(1, Number(item.quantity))),
+          iva_porcentaje: Number(item.tax_rate ?? 0),
+        })),
+      };
+      if (!payload.lineas.length) return json({ error: "La venta no tiene productos para facturar" }, 422);
+
+      const response = await fetch("https://api.jcflow.com.co/v1/api/documentos/factura", {
+        method: "POST",
+        headers: { Authorization: `Bearer ${apiKey}`, "Content-Type": "application/json" },
+        body: JSON.stringify(payload),
+      });
+      const result = await response.json().catch(() => ({}));
+      if (!response.ok || !result?.success) return json({ error: result?.mensaje ?? result?.message ?? `JCFlow respondió HTTP ${response.status}`, details: result }, 502);
+
+      const { data: invoice, error: insertError } = await admin.from("jcflow_invoices").insert({
+        tenant_id: tenantId, sale_id: saleId, cufe: result.cufe ?? null,
+        status: result.estado_dian ?? "issued", response: result,
+      }).select("id, cufe, status, response").single();
+      if (insertError) throw insertError;
+      return json({ ok: true, invoice });
+    }
+    return json({ error: "Acción no válida" }, 400);
+  } catch (error) {
+    console.error("jcflow_error", error);
+    return json({ error: error instanceof Error ? error.message : "Error interno" }, 500);
+  }
+});
+
+async function cryptoKey() {
+  const raw = Deno.env.get("TENANT_SECRETS_ENCRYPTION_KEY");
+  if (!raw) throw new Error("Falta configurar TENANT_SECRETS_ENCRYPTION_KEY en los secrets del servicio");
+  const bytes = Uint8Array.from(atob(raw), (c) => c.charCodeAt(0));
+  if (bytes.length !== 32) throw new Error("TENANT_SECRETS_ENCRYPTION_KEY debe ser una clave base64 de 32 bytes");
+  return crypto.subtle.importKey("raw", bytes, "AES-GCM", false, ["encrypt", "decrypt"]);
+}
+async function encrypt(value: string) {
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const encrypted = new Uint8Array(await crypto.subtle.encrypt({ name: "AES-GCM", iv }, await cryptoKey(), new TextEncoder().encode(value)));
+  const packed = new Uint8Array(iv.length + encrypted.length); packed.set(iv); packed.set(encrypted, iv.length);
+  return btoa(String.fromCharCode(...packed));
+}
+async function decrypt(value: string) {
+  const packed = Uint8Array.from(atob(value), (c) => c.charCodeAt(0));
+  const decrypted = await crypto.subtle.decrypt({ name: "AES-GCM", iv: packed.slice(0, 12) }, await cryptoKey(), packed.slice(12));
+  return new TextDecoder().decode(decrypted);
+}
+function json(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), { status, headers: { ...corsHeaders, "Content-Type": "application/json" } });
+}
diff --git a/apps/pos/supabase/functions/meta-whatsapp-webhook/index.ts b/apps/pos/supabase/functions/meta-whatsapp-webhook/index.ts
new file mode 100644
index 0000000..3876412
--- /dev/null
+++ b/apps/pos/supabase/functions/meta-whatsapp-webhook/index.ts
@@ -0,0 +1,93 @@
+import { createClient } from "npm:@supabase/supabase-js@2";
+
+const serviceKey = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!;
+const supabase = createClient(Deno.env.get("SUPABASE_URL")!, serviceKey);
+// @ts-ignore -- provided by Supabase Edge Runtime
+declare const EdgeRuntime: { waitUntil(promise: Promise<unknown>): void } | undefined;
+
+Deno.serve(async (req) => {
+  if (req.method === "GET") {
+    const url = new URL(req.url);
+    const mode = url.searchParams.get("hub.mode");
+    const token = url.searchParams.get("hub.verify_token");
+    const challenge = url.searchParams.get("hub.challenge");
+    if (mode === "subscribe" && token && token === Deno.env.get("META_WEBHOOK_VERIFY_TOKEN")) return new Response(challenge ?? "", { status: 200 });
+    return new Response("Forbidden", { status: 403 });
+  }
+  if (req.method !== "POST") return json({ error: "Method not allowed" }, 405);
+
+  const raw = await req.text();
+  const signature = req.headers.get("x-hub-signature-256") ?? "";
+  if (!await validSignature(raw, signature, Deno.env.get("META_APP_SECRET") ?? "")) return json({ error: "Invalid signature" }, 401);
+  let payload: any;
+  try { payload = JSON.parse(raw); } catch { return json({ error: "Invalid JSON" }, 400); }
+  if (payload.object !== "whatsapp_business_account") return json({ ok: true, ignored: true });
+
+  const tasks: Promise<unknown>[] = [];
+  for (const entry of payload.entry ?? []) for (const change of entry.changes ?? []) {
+    const value = change.value ?? {};
+    const phoneNumberId = String(value.metadata?.phone_number_id ?? "");
+    if (!phoneNumberId) continue;
+    for (const message of value.messages ?? []) tasks.push(processMessage(phoneNumberId, message, value.contacts?.[0]));
+  }
+  await Promise.allSettled(tasks);
+  return json({ ok: true, processed: tasks.length });
+});
+
+async function processMessage(phoneNumberId: string, message: any, contact: any) {
+  const from = String(message.from ?? "");
+  if (!from) return;
+  const { data: integration } = await supabase.from("tenant_meta_whatsapp_credentials")
+    .select("tenant_id, branch_id, display_phone").eq("phone_number_id", phoneNumberId).maybeSingle();
+  if (!integration) return;
+  const { data: config } = await supabase.from("ai_channel_configs").select("tenant_id, branch_id, is_active")
+    .eq("tenant_id", integration.tenant_id).eq("branch_id", integration.branch_id).eq("channel", "whatsapp").maybeSingle();
+  if (!config?.is_active) return;
+
+  let text = "";
+  if (message.type === "text") text = String(message.text?.body ?? "").trim();
+  else if (message.type === "interactive") text = String(message.interactive?.button_reply?.title ?? message.interactive?.list_reply?.title ?? "").trim();
+  else if (["image", "audio", "document", "video"].includes(message.type)) text = String(message[message.type]?.caption ?? `[El cliente envió ${message.type}]`).trim();
+  if (!text) return;
+
+  const customerPhone = from.replace(/\D/g, "");
+  const externalId = `${phoneNumberId}:${from}`;
+  const { data: conversation, error } = await supabase.from("ai_conversations").upsert({
+    tenant_id: integration.tenant_id, branch_id: integration.branch_id, channel: "whatsapp",
+    external_conversation_id: externalId, customer_phone: customerPhone, last_message_at: new Date().toISOString(),
+  }, { onConflict: "channel,external_conversation_id" }).select("id, status").single();
+  if (error || !conversation) return;
+
+  const messageId = String(message.id ?? "");
+  if (messageId) {
+    const { count } = await supabase.from("ai_messages").select("id", { count: "exact", head: true })
+      .eq("conversation_id", conversation.id).eq("direction", "inbound").filter("payload->>meta_message_id", "eq", messageId);
+    if ((count ?? 0) > 0) return;
+  }
+  await supabase.from("ai_messages").insert({
+    tenant_id: integration.tenant_id, conversation_id: conversation.id, direction: "inbound", body: text,
+    media_type: ["image", "audio", "document", "video"].includes(message.type) ? message.type : null,
+    payload: { _provider: "meta_cloud_api", meta_message_id: messageId || undefined, contact_name: contact?.profile?.name },
+  });
+  if (conversation.status === "handoff") return;
+  const agentTask = fetch(`${Deno.env.get("SUPABASE_URL")}/functions/v1/ai-order-agent`, {
+    method: "POST", headers: { "Content-Type": "application/json", Authorization: `Bearer ${serviceKey}` },
+    body: JSON.stringify({ conversation_id: conversation.id, message: text, instance: phoneNumberId, remote_jid: from }),
+    signal: AbortSignal.timeout(120_000),
+  }).then(async (res) => { if (!res.ok) console.error("meta_whatsapp_agent_failed", res.status, await res.text().catch(() => "")); })
+    .catch((error) => console.error("meta_whatsapp_agent_error", error));
+  if (typeof EdgeRuntime !== "undefined") EdgeRuntime.waitUntil(agentTask);
+  else await agentTask;
+}
+
+async function validSignature(body: string, signature: string, secret: string) {
+  if (!signature.startsWith("sha256=") || !secret) return false;
+  const key = await crypto.subtle.importKey("raw", new TextEncoder().encode(secret), { name: "HMAC", hash: "SHA-256" }, false, ["sign"]);
+  const digest = new Uint8Array(await crypto.subtle.sign("HMAC", key, new TextEncoder().encode(body)));
+  const expected = `sha256=${[...digest].map((b) => b.toString(16).padStart(2, "0")).join("")}`;
+  if (expected.length !== signature.length) return false;
+  let diff = 0;
+  for (let i = 0; i < expected.length; i++) diff |= expected.charCodeAt(i) ^ signature.charCodeAt(i);
+  return diff === 0;
+}
+function json(body: unknown, status = 200) { return new Response(JSON.stringify(body), { status, headers: { "Content-Type": "application/json" } }); }
