+    const { error } = await service.from("tenant_meta_whatsapp_credentials").upsert({
+      tenant_id: tenantId, branch_id: branchId, encrypted_access_token: encrypted, phone_number_id: phoneNumberId,
+      waba_id: wabaId, display_phone: account.display_phone_number ?? null, updated_at: new Date().toISOString(),
+    }, { onConflict: "tenant_id,branch_id" });
+    if (error) throw error;
+    const channelPayload = {
+      tenant_id: tenantId, branch_id: branchId, channel: "whatsapp", phone_number: account.display_phone_number ?? null,
+      is_active: true, config: { provider: "meta_cloud_api", phone_number_id: phoneNumberId }, updated_at: new Date().toISOString(),
+    };
+    const { data: oldChannel } = await service.from("ai_channel_configs").select("id, config").eq("branch_id", branchId).eq("channel", "whatsapp").maybeSingle();
+    if (oldChannel) channelPayload.config = { ...(oldChannel.config as Record<string, unknown> ?? {}), provider: "meta_cloud_api", phone_number_id: phoneNumberId };
+    const { error: channelError } = oldChannel
+      ? await service.from("ai_channel_configs").update(channelPayload).eq("id", oldChannel.id)
+      : await service.from("ai_channel_configs").insert(channelPayload);
+    if (channelError) throw channelError;
