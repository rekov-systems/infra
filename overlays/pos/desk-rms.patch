+async function decryptMetaToken(value: string): Promise<string> {
+  const keyBase64 = Deno.env.get("TENANT_SECRETS_ENCRYPTION_KEY");
+  if (!keyBase64) throw new Error("TENANT_SECRETS_ENCRYPTION_KEY is not configured");
+  const keyBytes = Uint8Array.from(atob(keyBase64), (c) => c.charCodeAt(0));
+  if (keyBytes.length !== 32) throw new Error("TENANT_SECRETS_ENCRYPTION_KEY must decode to 32 bytes");
+  const packed = Uint8Array.from(atob(value), (c) => c.charCodeAt(0));
+  const key = await crypto.subtle.importKey("raw", keyBytes, "AES-GCM", false, ["decrypt"]);
+  const clear = await crypto.subtle.decrypt({ name: "AES-GCM", iv: packed.slice(0, 12) }, key, packed.slice(12));
+  return new TextDecoder().decode(clear);
+}
