+// All outbound WhatsApp messaging uses Meta Cloud API credentials saved per branch.
+async function sendMetaPayload(conversationId: string, message: Record<string, unknown>): Promise<{ ok: boolean; error: string | null }> {
+  const { data: conversation } = await supabase.from("ai_conversations")
+    .select("tenant_id, branch_id, customer_phone").eq("id", conversationId).single();
+  if (!conversation) return { ok: false, error: "Conversation not found" };
+  const { data: integration } = await supabase.from("tenant_meta_whatsapp_credentials")
+    .select("encrypted_access_token, phone_number_id").eq("tenant_id", conversation.tenant_id)
+    .eq("branch_id", conversation.branch_id).maybeSingle();
+  if (!integration || !conversation.customer_phone) return { ok: false, error: "Meta WhatsApp no está conectado para esta sucursal" };
+  const token = await decryptMetaToken(integration.encrypted_access_token);
+  const version = (Deno.env.get("META_GRAPH_VERSION") ?? "v26.0").replace(/^v?/i, "v");
+  const recipient = conversation.customer_phone.replace(/\D/g, "");
+  const response = await fetch(`https://graph.facebook.com/${version}/${integration.phone_number_id}/messages`, {
+    method: "POST", headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
+    body: JSON.stringify({ messaging_product: "whatsapp", recipient_type: "individual", to: recipient, ...message }),
+    signal: AbortSignal.timeout(15_000),
+  });
+  if (response.ok) return { ok: true, error: null };
+  const detail = await response.text().catch(() => "");
+  return { ok: false, error: `Meta Graph HTTP ${response.status}: ${detail}` };
 }
 
