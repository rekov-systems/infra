+CREATE TABLE IF NOT EXISTS public.tenant_jcflow_credentials (
+  tenant_id uuid PRIMARY KEY REFERENCES public.tenants(id) ON DELETE CASCADE,
+  encrypted_api_key text NOT NULL,
+  updated_at timestamptz NOT NULL DEFAULT now()
+);
+
+CREATE TABLE IF NOT EXISTS public.jcflow_invoices (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  tenant_id uuid NOT NULL REFERENCES public.tenants(id) ON DELETE CASCADE,
+  sale_id uuid NOT NULL REFERENCES public.sales(id) ON DELETE RESTRICT,
+  cufe text,
+  status text NOT NULL,
+  response jsonb NOT NULL DEFAULT '{}'::jsonb,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  UNIQUE (tenant_id, sale_id)
+);
+
+CREATE TABLE IF NOT EXISTS public.tenant_meta_whatsapp_credentials (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  tenant_id uuid NOT NULL REFERENCES public.tenants(id) ON DELETE CASCADE,
+  branch_id uuid NOT NULL REFERENCES public.branches(id) ON DELETE CASCADE,
+  phone_number_id text NOT NULL UNIQUE,
+  encrypted_access_token text NOT NULL,
+  waba_id text,
+  display_phone text,
+  updated_at timestamptz NOT NULL DEFAULT now(),
+  UNIQUE (tenant_id, branch_id)
+);
+
+ALTER TABLE public.tenant_jcflow_credentials ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.jcflow_invoices ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.tenant_meta_whatsapp_credentials ENABLE ROW LEVEL SECURITY;
+
+CREATE POLICY "jcflow_credentials_owner_write" ON public.tenant_jcflow_credentials
+  FOR ALL TO authenticated
+  USING (public.has_any_role(auth.uid(), tenant_id, ARRAY['owner','admin']::public.app_role[]))
+  WITH CHECK (public.has_any_role(auth.uid(), tenant_id, ARRAY['owner','admin']::public.app_role[]));
+
+CREATE POLICY "jcflow_invoices_member_select" ON public.jcflow_invoices
+  FOR SELECT TO authenticated
+  USING (public.is_tenant_member(auth.uid(), tenant_id));
+
+REVOKE ALL ON public.tenant_jcflow_credentials FROM anon, authenticated;
+REVOKE ALL ON public.tenant_meta_whatsapp_credentials FROM anon, authenticated;
+REVOKE INSERT, UPDATE, DELETE ON public.jcflow_invoices FROM anon, authenticated;
+GRANT SELECT ON public.jcflow_invoices TO authenticated;
