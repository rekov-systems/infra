+    window.location.assign(`${back}/sso#${fragment.toString()}`);
+    return;
+  }
+  const requested = safeNextPath(searchParams.get("next"), "/rms/onboarding");
+  const next = requested.startsWith("/rms/") ? requested : "/rms/onboarding";
+  fragment.set("next", next);
+  window.location.assign(`/rms/sso#${fragment.toString()}`);
+}
+
+function supabaseAuthHeaders() {
+  const key = process.env.NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY;
+  if (!key) throw new Error("Falta la llave pública de autenticación.");
+  return { apikey: key, "Content-Type": "application/json" };
+}
