ERPNEXT_IMAGE=frappe/erpnext:v16.54.0
FRAPPE_SITE_NAME=erp.example.com
ADMIN_PASSWORD=change-me-strong
MYSQL_ROOT_PASSWORD=change-me-db-root

# Optional: Cloudflare R2 (S3 API) — configure after first boot via bench or site_config.json
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Optional: outbound email (Bavimail SMTP) — set in ERPNext UI or site_config.json
# MAIL_SERVER=
# MAIL_PORT=587
# MAIL_LOGIN=
# MAIL_PASSWORD=
