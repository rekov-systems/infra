# Copy to .env and export before terraform (do not commit .env).
# OCI API key (PEM). Prefer newline as \n when passing inline.
export TF_VAR_private_key="$(cat /path/to/oci_api_key.pem)"
export TF_VAR_cloudflare_api_token="your_cloudflare_api_token"

# ERPNext first-boot passwords (required by terraform/variables.tf)
export TF_VAR_erpnext_admin_password="change-me-admin"
export TF_VAR_erpnext_mysql_root_password="change-me-mariadb"

# Optional encrypted key
# export TF_VAR_oci_private_key_password="..."

# Serial console (opc user on Oracle Linux): set a first-boot password; empty skips
# export TF_VAR_instance_console_password="..."
